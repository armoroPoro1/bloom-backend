# Local development. No external service is needed for this mode.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_DRIVER=pglite
PGLITE_DIR=./var/database
# For PostgreSQL: set DATABASE_DRIVER=postgres and your own connection string.
DATABASE_URL=
UPLOAD_DIR=./var/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact reverse-proxy IPs/CIDRs only. Empty means forwarded headers are not trusted.
TRUST_PROXY_CIDRS=
PUBLIC_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
ALLOW_DEV_PAYMENTS=false
# Unpaid bank-transfer reservation window, in minutes (5 to 10080).
PAYMENT_RESERVATION_MINUTES=1440
# Runs mail and maintenance inside the API using its existing SQL connection.
# Disable only when separate PostgreSQL workers are scheduled elsewhere.
BACKGROUND_JOBS=true
MAIL_INTERVAL_SECONDS=10
MAINTENANCE_INTERVAL_SECONDS=60
ACCESS_MINUTES=15
REFRESH_DAYS=30
DOCS_ENABLED=true
LOG_LEVEL=info
# Without SMTP, the local worker writes mail to MAIL_DIR; it sends nothing externally.
SMTP_URL=
MAIL_FROM=Bloom <noreply@example.test>
MAIL_DIR=./var/mail
# Required only for npm run db:seed. Choose a local demonstration password.
SEED_DEMO_PASSWORD=
# Required only for npm run admin:create. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Bloom Administrator

